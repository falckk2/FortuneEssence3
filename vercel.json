{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["arn1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-reservations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/send-abandoned-cart-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
