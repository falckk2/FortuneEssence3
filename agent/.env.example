# Copy to .env and fill in values

# Supabase (same project as the Next.js app)
SUPABASE_URL=https://hvxggcskfwnayjvzdein.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Development: use Ollama (free, local, no API keys needed) ──────────────
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434   # default Ollama port
OLLAMA_LLM_MODEL=llama3.2               # or mistral, phi3, gemma2
OLLAMA_EMBED_MODEL=nomic-embed-text     # 768-dim, excellent retrieval quality

# ── Production: use Anthropic + OpenAI (comment out USE_OLLAMA above) ──────
# USE_OLLAMA=false
# ANTHROPIC_API_KEY=your-anthropic-key   # for the LLM (claude-sonnet-4-6)
# OPENAI_API_KEY=your-openai-key         # for embeddings (text-embedding-3-large)
