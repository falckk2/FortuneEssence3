# =============================================================================
# FortuneEssence — environment variables
# Copy to .env.local for local development.
# Set each variable in the Railway dashboard per service.
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js service
# -----------------------------------------------------------------------------

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SECRET_KEY=eyJ...
DATABASE_URL=postgresql://user:password@host:5432/postgres

# NextAuth — NEXTAUTH_URL must match NEXT_PUBLIC_APP_URL in production
NEXTAUTH_URL=https://your-app.up.railway.app
NEXTAUTH_SECRET=                          # openssl rand -base64 32

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@fortuneessence.se
EMAIL_FROM_NAME=Fortune Essence
EMAIL_SUPPORT=support@fortuneessence.se

# Cron job auth — generate once, share to both cron services and this service
CRON_SECRET=                              # openssl rand -hex 32

# AI advisor — Railway private URL of the agent service
# In Railway: http://<agent-service-name>.railway.internal:8000
ADVISOR_API_URL=http://localhost:8000

# Shipping carriers
POSTNORD_API_KEY=
DHL_API_KEY=

# Swish (optional)
SWISH_MERCHANT_ID=
SWISH_CERTIFICATE_PATH=
SWISH_PRIVATE_KEY_PATH=

# Klarna (optional)
KLARNA_USERNAME=
KLARNA_PASSWORD=

# Sender address on shipping labels (these defaults match the code fallbacks)
COMPANY_NAME=Fortune Essence
COMPANY_LEGAL_SUFFIX=AB
COMPANY_STREET=Lärlingsgatan 1
COMPANY_CITY=Göteborg
COMPANY_POSTAL_CODE=11143
COMPANY_COUNTRY=Sweden

# Enable test API endpoints (never set to true in production)
ENABLE_TEST_ENDPOINTS=false

# -----------------------------------------------------------------------------
# Agent service  (agent/)
# Set these in the Railway agent service, not the Next.js service
# -----------------------------------------------------------------------------

# Choose one LLM provider:

# Option A — Anthropic Claude + OpenAI embeddings (default)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Option B — Grok (xAI) + fastembed (already bundled in Docker image)
# USE_GROK=true
# XAI_API_KEY=xai-...

# Option C — Ollama (local only, not suitable for Railway)
# USE_OLLAMA=true

# CORS: set to the Next.js Railway URL so the agent accepts cross-origin requests
# (only needed if the browser ever calls the agent directly)
APP_URL=https://your-app.up.railway.app

# -----------------------------------------------------------------------------
# Cron services  (cron/cleanup-reservations  and  cron/abandoned-cart)
# Both cron services need these two variables:
# -----------------------------------------------------------------------------

# Public URL of the Next.js service
# APP_URL=https://your-app.up.railway.app

# Must match CRON_SECRET set on the Next.js service
# CRON_SECRET=same-value-as-above
